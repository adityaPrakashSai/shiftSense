# Copy to .env (make setup does this). Never commit real keys; .env is git-ignored.
# Design doc section 3.5.

# live | replay | mock. Local dev and tests default to mock; the deployed app uses live.
LLM_MODE=mock
LLM_PROVIDER_DEFAULT=baseten
# Per-role overrides (baseten | meta | modal); leave unset to use the default
# LLM_PROVIDER_INTAKE=
# LLM_PROVIDER_EXPLAIN=
# LLM_PROVIDER_MESSAGE=
# LLM_PROVIDER_VISION=   (roster photos and voice notes)

# Baseten: Muse Spark Open (open weights), OpenAI-compatible endpoint
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Meta Model API: Muse Spark (exact id from the model list page)
META_API_KEY=
META_BASE_URL=
META_MODEL=

# Optional self-hosted endpoint (P2)
MODAL_API_KEY=
MODAL_BASE_URL=
MODAL_MODEL=

LLM_SPEND_CAP_USD=5.00
# On Railway: DB_PATH=/data/shiftsense.db and LOG_DIR=/data/logs, with the volume mounted at /data
DB_PATH=data/shiftsense.db
# Seed for make seed and for an empty DB at startup: default | mini | real_a. The demo (/demo, the
# scripted messages in data/llm_cache.jsonl) uses mini with "now" frozen on the sick-call morning;
# mini's solved baseline is committed (data/seed/mini_baseline.json), so every clone matches.
SEED=mini
WARD_TZ=Asia/Kolkata
# Freeze "now" for reproducible demos and evals; leave empty for the real clock
DEMO_NOW=2026-11-03T06:05:00+05:30
# Demo opening: published (a solved roster is ready) or empty (the charge nurse
# generates this period's roster first). POST /api/demo/reset accepts {"mode": ...}
# to override per call; seeds with their own printed plan (real_a) only support published.
DEMO_START=published
# 8 locally, 4 on Railway
SOLVER_WORKERS=8
SOLVER_STAGE_SECONDS=5
SOLVER_TOTAL_SECONDS=9
LOG_DIR=logs
# After each solve, re-solve each denied request as granted to find its reason code (<= 20 s)
EXPLAIN_DENIED=true
# The roster agent (Muse Spark) runs sick calls, conflicts, leave, swaps and new periods
AGENT_ENABLED=true
# A nurse who never answers an ask: the wait expires after this many seconds of real
# wall-clock time and the task re-plans. The demo video uses 60.
AGENT_REPLY_TIMEOUT_SECONDS=1800
