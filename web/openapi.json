     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/runs/{run_id}": {
   "get": {
    "tags": [
     "runs"
    ],
    "summary": "Get Run",
    "operationId": "get_run_api_runs__run_id__get",
