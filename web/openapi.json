 },
 "paths": {
  "/api/health": {
   "get": {
    "tags": [
     "misc"
    ],
    "summary": "Health",
    "operationId": "health_api_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/api/events": {
   "get": {
    "tags": [
     "misc"
    ],
    "summary": "Events",
    "description": "Events after `after_seq` in order; `last=N` returns the newest N instead (oldest first).",
    "operationId": "events_api_events_get",
    "parameters": [
     {
      "name": "run_id",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Run Id"
      }
     },
     {
      "name": "after_seq",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 0,
       "title": "After Seq"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 2000,
       "minimum": 1,
       "default": 500,
       "title": "Limit"
      }
     },
     {
      "name": "last",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 2000,
         "minimum": 1
        },
        {
         "type": "null"
        }
       ],
       "title": "Last"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/EventOut"
         },
         "title": "Response Events Api Events Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/demo/reset": {
   "post": {
    "tags": [
     "misc"
    ],
    "summary": "Demo Reset",
    "operationId": "demo_reset_api_demo_reset_post",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ResetOut"
        }
       }
      }
     }
    }
   }
  },
  "/api/dev/ws-off": {
   "post": {
    "tags": [
     "misc"
    ],
    "summary": "Ws Off",
    "description": "Close every WebSocket and refuse new ones for a while, to check the polling fallback.",
    "operationId": "ws_off_api_dev_ws_off_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/WsOff"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": {
          "type": "integer"
         },
         "type": "object",
         "title": "Response Ws Off Api Dev Ws Off Post"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
