  },
  "/api/runs/{run_id}/lineage": {
   "get": {
    "tags": [
     "runs"
    ],
    "summary": "Lineage",
    "description": "The run and its ancestors, oldest first (seed baseline -> ... -> this run).",
    "operationId": "lineage_api_runs__run_id__lineage_get",
    "parameters": [
     {
      "name": "run_id",
